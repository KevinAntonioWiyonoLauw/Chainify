
WEB_PORT=13000
API_PORT=13001
CSS_PORT=13002
CSS_UPSTREAM_PORT=13003

LAN_HOST=192.168.18.9
CSS_BASE_URL=https://localhost:13002/
ALLOWED_ORIGINS=https://localhost:13000
WEBID_FETCH_ALLOWLIST=css,css:3000,localhost,localhost:13000,localhost:13002,.solidcommunity.net,.inrupt.net,.solidweb.org
CSS_ISSUER_URL=https://localhost:13002/

CHAINIFY_EXTRA_CA_FILE=certs/chainify.crt

FETCH_TIMEOUT_MS=8000

