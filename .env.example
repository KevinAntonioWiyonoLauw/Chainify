# Next.js: dereferenceable Solid-OIDC client identifier document URL.
NEXT_PUBLIC_SOLID_CLIENT_ID=https://localhost:13000/id
# Next.js: public application origin used by browser integrations.
NEXT_PUBLIC_APP_URL=https://localhost:13000
